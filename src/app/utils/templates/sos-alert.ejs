<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🚨 SOS Alert</title>
  </head>
  <body>
    <h2>🚨 SOS Alert</h2>
    <p>An emergency signal has been triggered!</p>
    <p><strong>Ride ID:</strong> <%= rideId %></p>
    <p><strong>User ID:</strong> <%= user %></p>
    <p><strong>Location:</strong> <%= location || "No location provided" %></p>
    <p><strong>Message:</strong> <%= message || "No message provided" %></p>
  </body>
</html>
